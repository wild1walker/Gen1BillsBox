-- Sharing metadata: read by tooling and the mod manager's detail pane.
return {
  summary = "Bill's PC, replaced by the box it was always standing in for: "
    .. "the party down the left, twenty visible slots on the right, and a "
    .. "cursor that carries a POKeMON.",
  author = "wild1walker",
  tags = { "ui", "storage", "quality-of-life", "boxes" },
  compat = { engine = ">=0.0.0-0 <2.0.0", modApi = 2, games = { "gen1" } },
  differences = {
    changed = {
      "Bill's PC opens a box grid instead of the WITHDRAW / DEPOSIT / RELEASE / CHANGE BOX menu -- it is a replacement, not a second entrance",
      "the PC's storage row reads SOMEONE'S BOX before Bill and BILL'S BOX after, and the three lines that name the machine elsewhere follow it",
      "withdrawing and depositing are one button press each rather than a list, a submenu and a confirmation, so neither prints its own message any more",
      "changing box no longer offers to save: the cart's prompt was swapping an SRAM bank, and this engine keeps all twelve boxes in one save file",
      "STATS and RELEASE moved to START, because A became pick up and put down",
    },
    added = {
      "gaps: a POKeMON picked up leaves its cell empty and one put down lands in the cell you aimed at, with the arrangement kept beside the box in this mod's own save data and reconciled with it on every read",
      "a POKeMON in your hand slowly flashes -- lit far longer than dark, because the thing flashing is the thing you are trying to look at",
      "the open box follows a catch that overflowed, so the PC stops opening on a box with no room in it and the next catch lands directly in one with space (SWITCH ON FULL)",
      "one line after a catch that overflowed, naming the box that was full and the box the POKeMON actually went to -- only when those differ, so an ordinary catch stays as quiet as it was",
      "a palette zone per POKeMON, in the grid and in the party, so each one wears its own species colours -- a box's worth at once, where the Game Boy could show four",
      "a cursor in the band above a POKeMON's head pointing down at it, and the same arrow hollow while that POKeMON is in your hand; the party pane keeps the party menu's own sideways filled/hollow pair",
      "the party and the open box are visible together on one 160x144 screen: six party slots down the left, the box as a 5x4 grid of twenty",
      "A picks a POKeMON up, puts it down, or swaps it with whatever is in the target slot",
      "B is back and only back -- it puts a carried POKeMON down in the slot, and the box, it came from, and closes the screen only when your hands are empty",
      "a carried POKeMON stays with the cursor across a box change, which makes a cross-box move one operation",
      "LEFT out of the first column crosses to the party and RIGHT crosses back; SELECT does it from anywhere",
      "UP out of the top row lands on the box header, where LEFT and RIGHT change box and A opens the twelve-box list",
      "one line under the grid naming what the cursor is on, or 'Move to where?' while something is carried",
      "PLACE CRY (on by default), HOLD TO MOVE (on by default) and OPEN ON, in the mod manager",
    },
    known = {
      "the party still closes up behind a POKeMON taken out of it, because a party of six with a hole in it is not something the rest of the game would understand; only the boxes take gaps",
      "anything may add to a box behind this screen's back -- a catch overflowing into it, another mod, an imported .sav -- so the arrangement is reconciled with the box on every read: new arrivals take the lowest free cell, spare cells are dropped, and a cell out of range or claimed twice is thrown away",
      "authored full-colour icons are marked with PaletteFX.markTrueColor and given no species zone, because the SGB pass keys each pixel off its RED channel and would paint an orange POKeMON white rather than recolouring it; nothing in PartyMenu.drawIcon marks them, so the screen drawing them has to",
      "which icons those are is decided by reading the pixels of whatever the icon path resolves to -- the one test the icons registry, a species record's own icon, an asset override and the pokemon.icon hook cannot route around; a built-in icon CLASS is never full colour, because drawIcon bakes those to grey through obpIcon",
      "asked for as Gen 2 behaviour, though Gold does the opposite: a full party AND a full current box refuses the throw there (Ball_BoxIsFullMessage) and Bill rings you when a box fills; advancing to the next box with room is Gen 3's answer, and it is the right one on an engine that already refuses to lose the catch",
      "the note says which actually happened -- 'Now using BOX n.' when the open box followed, 'Stored in BOX n.' when SWITCH ON FULL is off -- so it can never claim a switch that did not occur",
      "the icon is centred ACROSS the cell but deliberately not down it: a gap, the 4-pixel cursor, a gap, the 16-pixel icon and a gap do not fit in the 23 pixels between two rules with any slack left over, and the gaps that must not go to zero are the ends -- an arrow drawn on the rule reads as a smear on the grid, and an icon on the next rule sits on the line",
      "the overflow itself is the ENGINE's, not this mod's: src/pokemon/Boxes.lua's deposit already walks from the open box forward through all twelve and wraps, and a catch only fails once all 240 places are taken; what this mod adds is the line that says which box it landed in",
      "the box number cannot go into the transfer line itself -- that text is ROM-extracted and filled from the caller's arguments, and the battle passes exactly one, so a second slot fails RomText's arity check and drops the line back to the engine's English",
      "every pixel this mod draws itself is shade 3, which is {0,0,0} in the grey ramp and in all 151 species palettes alike -- that is what keeps the chrome black under a zone laid over it; shade 1 is the trap, since MEWMON paints it {239,156,107} and a grey grid line under MEWMON is an orange grid line",
      "cells are 24x24 and party rows 16 tall because an SGB palette zone is addressed in TILES: a cell three and a half tiles wide cannot carry one at all, and carrying one per cell is the whole point",
      "the COLORS display mode still decides what a species palette contains -- ADVANCED resolves the per-species pokered-gbc colours, CLASSIC and the OG modes replace every palette on screen; this mod asks for the zone and the mode answers",
      "the party pane cannot take the down arrow: six rows of sixteen fill its ninety-six pixels exactly, so there is no band above a party POKeMON's head to put one in",
      "every slot is drawn with PartyMenu.drawIcon, the engine's own party-menu icon path, so an icon mod reaches the box with nothing to configure -- and a species with no per-species icon shows the same generic shape here that it shows in the party",
      "a box stays a COMPACT array in the SAVE -- the shape src/pokemon/Boxes.lua and the save format use, and what is left behind if this mod is removed; the grid arrangement lives beside it rather than in it, so nothing about the save changes and the order of the array stopped meaning anything",
      "the grid has exactly as many cells as a box has room, so a full box has no empty cell to aim at: every drop into one is a swap, which is why a full party and a full box can still trade",
      "the party may not be emptied -- the last POKeMON cannot be picked up at all, which is the vanilla refusal enforced one step earlier so it cannot be walked around",
      "RELEASE is offered for boxed POKeMON only, which is where the vanilla PC offers it",
      "boxes have no names and no wallpapers; they are numbered, as they are on the cart",
      "the party is refreshed behind you on the way out so a follower does not keep walking as the POKeMON you just deposited; with Wilds of Kanto installed its own follower is re-synced too and may reappear standing on the player until your next step",
      "uses the engine_internals permission to keep the native save format, the summary screen, the cries and Yellow's Pikachu happiness",
      "conflicts with Modern PC UI, which replaces the same screen id; Gen 3 Box can be installed alongside, though that is two storage screens over one save",
    },
  },
  credits = {
    { who = "Gen1Recomp", for_ = "native storage, rendering and the mod platform" },
    { who = "Game Freak", for_ = "the box grid this is an homage to" },
  },
}
